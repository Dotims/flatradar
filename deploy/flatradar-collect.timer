[Unit]
Description=FlatRadar: collect every 15 minutes

[Timer]
# Two minutes after login rather than immediately, so a fresh boot is not competing
# with everything else starting at once.
OnStartupSec=2min
OnUnitActiveSec=15min
# Catch up on a missed run after the machine was asleep, instead of waiting for the
# next slot as if nothing happened.
Persistent=true
# Spread the moment of firing, so we are not one of the clients hitting both portals
# exactly on the quarter hour.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
