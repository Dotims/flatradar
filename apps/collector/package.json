{
  "name": "@flatradar/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "migrate": "node --env-file-if-exists=../../.env src/cli.ts migrate",
    "status": "node --env-file-if-exists=../../.env src/index.ts",
    "collect": "node --env-file-if-exists=../../.env src/cli.ts collect",
    "collect:olx": "node --env-file-if-exists=../../.env src/cli.ts collect:olx",
    "collect:otodom": "node --env-file-if-exists=../../.env src/cli.ts collect:otodom",
    "classify": "node --env-file-if-exists=../../.env src/cli.ts classify",
    "dedupe": "node --env-file-if-exists=../../.env src/cli.ts dedupe",
    "serve": "node --env-file-if-exists=../../.env src/cli.ts serve"
  }
}
