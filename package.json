{
  "name": "flatradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches new rental listings in Kraków on OLX and Otodom, filters them and pings Telegram",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "pnpm --filter @flatradar/collector collect",
    "serve": "pnpm --filter @flatradar/collector serve",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
