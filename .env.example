# Neon connection string. Never commit the real one.
DATABASE_URL=postgresql://user:password@host.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Guards /api/ingest/olx, which writes. Any long random string; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
INGEST_TOKEN=

# Optional, for the database tests. Must be a throwaway: they empty the tables.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
